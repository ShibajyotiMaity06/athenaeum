# ── DevPrep environment variables ───────────────────────────────────────────

# Session signing secret (e.g. openssl rand -hex 32)
AUTH_SECRET=your_auth_secret_key_here

# Public site URL
VITE_PUBLIC_SITE_URL=https://www.devprep.online

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (local)
#                          https://devprep.online/api/auth/google/callback (production)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Payment mode (live | sandbox)
PAYMENT_MODE=allow-sandbox

# Razorpay credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Default admin account & error report recipient
ADMIN_EMAIL=admin@devprep.online
ADMIN_PASSWORD=DevPrep#2026Admin
ADMIN_NOTIFY_EMAIL=shibajyoti.maity06@gmail.com

# Where the markdown files live
CONTENT_SOURCE=../interview-prep

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=DevPrep
MONGODB_DB=devprep
