# Copy to .env.local and fill in for your deployment.

# Required — session signing secret (openssl rand -hex 48)
AUTH_SECRET=

# Public site URL (canonical/SEO)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# live | allow-sandbox   (sandbox auto-enables only while Razorpay keys are empty)
PAYMENT_MODE=live

# Razorpay → Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Administrator seeded on first boot — change before going live!
# Quote passwords containing special characters (#, $, etc.)
ADMIN_EMAIL=will_not_tell
ADMIN_PASSWORD="change-me-immediately"

# Absolute or relative path to the interview-prep markdown collection
CONTENT_SOURCE=../interview-prep

# MongoDB connection (optional — falls back to local JSON store when empty)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=athenaeum
